# Copy to .env and adjust. Never commit .env.

# ── SauceDemo (shop) ─────────────────────────────────────────────
UI_BASE_URL=https://www.saucedemo.com
# Public demo credentials (published by the demo site itself)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# ── nIT (business tools site) ────────────────────────────────────
NIT_BASE_URL=https://nit.uganjaj.ba
# Optional: test a local copy of the site files instead of the live site.
# Point it at the folder that contains index.html; Playwright starts a
# small local server for it. Leave empty to test the live site.
# NIT_SITE_DIR=./nit-site

# ── Restful Booker (API) ─────────────────────────────────────────
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
